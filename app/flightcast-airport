  W.forEach(h => {
    wing += part(h.d);
    const sx = Math.sign(+h.X(1)), xf = h.xk + .5*(h.xt-h.xk);
    const ch = x => h.TE(x)-h.LE(x);
    det += poly(x => [sx*x, h.LE(x)+ch(x)*.13], r*1.1, h.xt*.97);
    det += poly(x => [sx*x, h.TE(x)-ch(x)*.28], r*1.05, xf);
    det += poly(x => [sx*x, h.TE(x)-ch(x)*.22], xf, h.xt*.96, 4);
    det += `M${F(sx*xf)} ${F(h.TE(xf)-ch(xf)*.28)} L${F(sx*xf)} ${F(h.TE(xf))}`;
    if (s.kind==='jet') det += `M${F(sx*xf*.92)} ${F(h.LE(xf*.92)+ch(xf*.92)*.38)} L${F(sx*xf*.92)} ${F(h.TE(xf*.92)-ch(xf*.92)*.3)}`;
    s.fair.forEach(f => {
      const x = r + f*(h.xt-r), c = ch(x), y1 = h.TE(x)-c*.2, y2 = h.TE(x)+c*.3, ww = Math.max(s.d*.075,.18), cx = sx*x;
      fair += part(`M${F(cx-ww/2)} ${F(y1+ww)} L${F(cx-ww/2)} ${F(y2-ww*1.5)} Q${F(cx)} ${F(y2+ww*.5)} ${F(cx+ww/2)} ${F(y2-ww*1.5)} L${F(cx+ww/2)} ${F(y1+ww)} Q${F(cx)} ${F(y1-ww*.3)} ${F(cx-ww/2)} ${F(y1+ww)}Z`);
    });
  });
  // fuselage
  const n=s.nl, t=s.tl, e=r*.14, nb=s.nb;
  const fd = `M0 0 C${F(r*nb)} 0 ${F(r)} ${F(n*.38)} ${F(r)} ${F(n)} L${F(r)} ${F(L-t)} C${F(r)} ${F(L-t*.45)} ${F(e*1.6)} ${F(L-t*.1)} ${F(e)} ${F(L)} L${F(-e)} ${F(L)} C${F(-e*1.6)} ${F(L-t*.1)} ${F(-r)} ${F(L-t*.45)} ${F(-r)} ${F(L-t)} L${F(-r)} ${F(n)} C${F(-r)} ${F(n*.38)} ${F(-r*nb)} 0 0 0Z`;
  fus = part(fd);
  let fdet = '';
  const yw = s.kind==='single' ? y0 - r*.35 : n*.5;
  fdet += `M${F(-r*.66)} ${F(yw)} Q0 ${F(yw-r*.55)} ${F(r*.66)} ${F(yw)}`;
  if (s.kind!=='single'){
    const ys = s.hump ? s.hump*L : n*1.15;
    fdet += `M${F(-r*.55)} ${F(ys)} L${F(-r*.55)} ${F(L-t*.8)} M${F(r*.55)} ${F(ys)} L${F(r*.55)} ${F(L-t*.8)}`;
    if (s.hump){ const yh=s.hump*L; fdet += `M${F(-r*.55)} ${F(yh)} L${F(-r*.55)} ${F(n*1.1)} Q${F(-r*.55)} ${F(n*.72)} 0 ${F(n*.64)} Q${F(r*.55)} ${F(n*.72)} ${F(r*.55)} ${F(n*1.1)} L${F(r*.55)} ${F(yh)} Q0 ${F(yh+r*.9)} ${F(-r*.55)} ${F(yh)}`; }
