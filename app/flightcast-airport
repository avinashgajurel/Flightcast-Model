function fuseHalfW(s,y){ const r=s.d/2, t=s.tl; if (y < s.L-t) return r; return Math.max(r*.14, r*(1-.86*(y-(s.L-t))/t)); }
function wingHalf(sx, o, r){
  const semi=o.S/2, ext=semi*TIP[o.tip], xt=semi-ext, t=Math.tan(o.sw*DEG), y0=o.y0, ct=o.ct;
  const LE = x => y0 + Math.max(0,x-r)*t;
  const xk = r + o.kink*(xt-r), rTE=y0+o.cr, kTE=LE(xk)+o.ck, tTE=LE(xt)+ct;
  const TE = x => x<=r ? rTE : x<=xk ? rTE+(kTE-rTE)*(x-r)/(xk-r) : kTE+(tTE-kTE)*(x-xk)/(xt-xk);
  const X = x => F(sx*x), p2y = LE(xt);
  let tip;
  switch(o.tip){
