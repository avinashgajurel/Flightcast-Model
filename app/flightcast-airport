function drawFixed(s){
  const r=s.d/2, L=s.L, sw=Math.max(L,s.S)*.0045, thin=sw*.75;
  const y0 = s.wx*L, w = {S:s.S, y0, cr:s.cr, ct:s.ct, sw:s.sw, kink:s.kink, ck:s.ck, tip:s.tip};
  const W = [wingHalf(1,w,r), wingHalf(-1,w,r)];
  const ht = s.ht, hy0 = ht.x*L;
  const isT = ht.t==='T';
  const stab = [1,-1].map(sx => stabHalf(sx, ht, hy0, isT ? r*.12 : fuseHalfW(s,hy0)*.9));
  const part = d => `<path d="${d}"/>`;
  let low='', eng='', wing='', fair='', det='', fus='', top='';

  // horizontal tail (low = under fuselage)
  const stabSvg = stab.map(h => part(h.d)).join('') ;
  const stabDet = stab.map(h => h.hinge).join('');

  // underwing jet engines (drawn first, wing covers their rear)
  s.eng.forEach(([f,l,D,fwd]) => W.forEach(h => {
    const x = f*s.S/2, cx = Math.sign(h.X(1))*x, yf = h.LE(x)-fwd;
    eng += part(nacelle(cx, yf, l, D)); det += intake(cx, yf, D) + ` M${F(cx)} ${F(yf+D*.42)} L${F(cx)} ${F(yf+fwd*.85)}`;
  }));
