    props += part(`M${F(-wv*.32)} 0.05 Q${F(-wv*.28)} ${F(-sp*.8)} 0 ${F(-sp)} Q${F(wv*.28)} ${F(-sp*.8)} ${F(wv*.32)} 0.05Z`);
