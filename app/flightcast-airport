  f.innerHTML = live ? (age > 15 ? `<i></i>Predicting${MODEL ? ` (model: ${(MODEL.trained.arrivals + MODEL.trained.departures).toLocaleString('en-AU')} past flights)` : ' from learned flow'} · last update ${age} s ago · ${src}` : `<i></i>Live · ${src} · ${lastOk ? Math.round((Date.now()-lastOk)/1000)+' s ago' : '—'}`)
    : `<i></i>Sample data · ${framed ? 'this page is running inside a preview window that blocks internet access. Open the file directly in Chrome.' : 'feeds unreachable: ' + (errors.join(' · ') || 'checking…')}`;
}
let timer, ticking = false;
/* Requests: every 10 s while anything is approaching, on or near a runway, or low in the sky nearby (the take-off and
   landing views need it). With an empty sky it slows to every 20 s (?idle=10 keeps 10 s always). Nothing is fetched
   while the screen is off or the app is in the background; it catches up the moment it's back. */
const IDLE = Math.max(REFRESH, +(q.get('idle') || 20));
function busy(list){
  return (list || []).some(a => {
    if (typeof a.lat !== 'number' || distKm(LAT, LON, a.lat, a.lon) > RADIUS_KM + 5) return false;
    if (a.alt_baro === 'ground') return (a.gs ?? 0) >= 3 && !!nearRunway(a.lat, a.lon, 400);   // moving near a runway
    return aglFtOf(a) < 7000;                                                                 // low enough to be arriving / departing
  });
}
let lastList = null;
async function tick(){
  if (document.visibilityState === 'hidden'){ clearTimeout(timer); timer = null; return; }   // screen off: stop asking
  if (ticking) return; ticking = true;
  try {
    const {list, source, opensky} = await fetchAircraft(); live=true; src=source; lastOk=Date.now();
    if (opensky) await Promise.all(inArea(list).slice(0,8).map(a => hexLookup(a.hex)));
    setFlights(opensky ? list.map(a => ({...a, ...(hexInfo.get(a.hex)||{})})) : list);
    lastList = list;
  }
  catch(e){ if (!lastOk){ live=false; DATA_AT = Date.now(); setFlights(sample()); } }
  ticking = false;
  feed(); clearTimeout(timer); timer = setTimeout(tick, (lastList && !busy(lastList) ? IDLE : REFRESH) * 1000);
}
setInterval(feed, 1000);
document.addEventListener('dblclick', () => { try { document.fullscreenElement ? document.exitFullscreen() : document.documentElement.requestFullscreen(); } catch(e){} });
async function wake(){ try { if (navigator.wakeLock && document.visibilityState==='visible') await navigator.wakeLock.request('screen'); } catch(e){} }
document.addEventListener('visibilitychange', () => { wake(); if (document.visibilityState === 'visible' && !timer) tick(); }); wake();
if (SERVED && 'serviceWorker' in navigator) navigator.serviceWorker.register('sw.js').catch(() => {});
tick();
})();
</script>
