    props += part(`M${F(cx-wv/2)} ${F(yf+wv*.35)} Q${F(cx-wv/2)} ${F(yf)} ${F(cx)} ${F(yf)} Q${F(cx+wv/2)} ${F(yf)} ${F(cx+wv/2)} ${F(yf+wv*.35)} L${F(cx+wv/2)} ${F(yf+p.nl*.7)} Q${F(cx+wv*.4)} ${F(yf+p.nl)} ${F(cx)} ${F(yf+p.nl)} Q${F(cx-wv*.4)} ${F(yf+p.nl)} ${F(cx-wv/2)} ${F(yf+p.nl*.7)}Z`);
