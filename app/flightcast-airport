  const pre = [[/^A31/,'A319'],[/^A32/,'A320'],[/^A33/,'A333'],[/^A35/,'A359'],[/^A34/,'A343'],[/^A38/,'A388'],[/^B73/,'B738'],[/^B3/,'B38M'],[/^B74/,'B744'],[/^B75/,'B752'],[/^B76/,'B763'],[/^B77/,'B77W'],[/^B78/,'B789'],[/^E1/,'E190'],[/^E2/,'E295'],[/^CRJ/,'CRJ9'],[/^AT/,'AT76'],[/^DH8/,'DH8D'],[/^C25|^C5|^C6/,'C25A'],[/^GLF|^GL/,'GLF6'],[/^LJ/,'LJ45'],[/^FA/,'FA7X'],[/^EC|^AS|^H1/,'EC35'],[/^R[0-9]/,'R44'],[/^C1[0-9]/,'C172'],[/^PA|^P2/,'PA28'],[/^BE/,'B350']];
