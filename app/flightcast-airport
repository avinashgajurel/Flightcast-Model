<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>FlightCast Airport</title>
<link rel="manifest" href="airport.webmanifest">
<link rel="icon" href="icon-192.png">
<link rel="apple-touch-icon" href="icon-192.png">
<meta name="theme-color" content="#EEF2F6">
<meta name="mobile-web-app-capable" content="yes">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;600;700;800&family=Barlow:wght@400;500;600&display=swap">
<style>
/* Layout: one screen. Left: the aircraft as a large top-down silhouette. Right: tail-fin badge, flight, route, numbers. */
:root{
  --paper:#EEF2F6;   /* pale sky ground; also the cut lines inside the silhouettes */
  --ink:#10151D;     /* silhouette */
  --fg:#131A24;
  --muted:#5E6B7D;
  --line:#D3DBE5;
  --al:#2F5FD0;      /* set per airline */
  --cloud:#DCE4EE;   /* soft haze blobs a shade darker than the sky */
  --streak:#BAC6D4;
  --shadow:rgba(16,21,29,.22);
  --display:"Barlow Condensed","Arial Narrow","Roboto Condensed",sans-serif;
  --body:"Barlow",system-ui,-apple-system,"Segoe UI",sans-serif;
  color-scheme:light;
}
/* weather moods: the page ground shifts with the sky; night flips to a dark sky with a pale aircraft */
:root[data-sky="cloudy"]{--paper:#E5E9EE;--cloud:#D3DAE3}
:root[data-sky="fog"]{--paper:#E8EAEC;--cloud:#D9DDE1}
:root[data-sky="rain"]{--paper:#DCE2E9;--cloud:#C9D2DC;--streak:#A9B6C5}
:root[data-sky="storm"]{--paper:#D1D7DF;--cloud:#BCC5D0;--streak:#9AA8B8;--muted:#56637A}
:root[data-sky="snow"]{--paper:#E4EAF1;--cloud:#D4DCE6}
:root[data-night]{--paper:#0C1424;--ink:#E6ECF5;--fg:#E9EEF6;--muted:#8D9BB2;--line:#26334A;--cloud:#18233A;--streak:#34445F;--shadow:rgba(0,0,0,.55);color-scheme:dark}
:root[data-night][data-sky="storm"],:root[data-night][data-sky="rain"]{--paper:#0F1622}
*{box-sizing:border-box}
body{transition:background-color 2s}
.sky{position:fixed;inset:0;z-index:0;pointer-events:none;overflow:hidden}
.sky canvas{position:absolute;inset:0;width:100%;height:100%}
.app{position:relative;z-index:1}
.sun,.moon{position:absolute;opacity:0;transition:opacity 2s}
.sun{right:-22vmax;top:-22vmax;width:60vmax;height:60vmax;border-radius:50%;
  background:radial-gradient(closest-side,rgba(255,214,120,.55),rgba(255,214,120,.18) 45%,transparent)}
.sun .rays{position:absolute;inset:-30%;border-radius:50%;animation:spin 140s linear infinite;
  background:repeating-conic-gradient(from 0deg,rgba(255,206,110,.16) 0 4deg,transparent 4deg 15deg);
  -webkit-mask-image:radial-gradient(closest-side,#000 20%,transparent 75%);mask-image:radial-gradient(closest-side,#000 20%,transparent 75%)}
@keyframes spin{to{transform:rotate(360deg)}}
.moon{right:7vw;top:8vh;width:9vmin;height:9vmin;border-radius:50%;background:#F4F1E4;
  box-shadow:0 0 6vmin 2vmin rgba(244,241,228,.18),0 0 22vmin 8vmin rgba(160,180,220,.10)}
.moon::after{content:"";position:absolute;inset:0;border-radius:50%;background:radial-gradient(circle at 30% 35%,rgba(0,0,0,.06) 0 8%,transparent 9%),radial-gradient(circle at 62% 62%,rgba(0,0,0,.07) 0 12%,transparent 13%),radial-gradient(circle at 58% 28%,rgba(0,0,0,.05) 0 6%,transparent 7%)}
.sky.sunny .sun{opacity:1}
.sky.hazy .sun{opacity:.45}
.sky.moonlit .moon{opacity:1}
.sky.moonhaze .moon{opacity:.35}
.flash{position:absolute;inset:0;background:#fff;opacity:0}
.flash.go{animation:flash .9s ease-out}
@keyframes flash{0%{opacity:0}8%{opacity:.32}16%{opacity:.04}24%{opacity:.22}100%{opacity:0}}
.phase{display:flex;align-items:center;gap:10px;font:700 clamp(18px,2vw,24px) var(--display);letter-spacing:.12em;text-transform:uppercase;color:var(--fg);min-height:26px}
.phase:empty,.queue:empty{display:none}
.queue{display:flex;flex-wrap:wrap;gap:6px 18px;font:600 15px var(--body);color:var(--muted)}
.queue b{color:var(--fg);font-weight:600}
.phase i{width:10px;height:10px;border-radius:50%;background:var(--al)}
.phase b{padding:2px 10px;border-radius:6px;background:var(--fg);color:var(--paper);letter-spacing:.08em}
.wx{font:600 clamp(16px,1.6vw,20px) var(--body);color:var(--fg);display:flex;align-items:center;gap:10px;min-height:24px}
.wx svg{width:26px;height:26px;flex:none}
.wx span{color:var(--muted);font-weight:500}
@media (prefers-reduced-motion:reduce){.sun .rays{animation:none}.flash.go{animation:none}}
[hidden]{display:none!important}
html,body{height:100%;margin:0}
body{background:var(--paper);color:var(--fg);font-family:var(--body);overflow-x:hidden}
.app{height:100%;min-height:100%;display:grid;grid-template-columns:minmax(0,1.15fr) minmax(0,1fr);gap:clamp(16px,3vw,56px);align-items:center;
  padding-block:clamp(16px,3vh,40px);padding-left:max(clamp(16px,3vw,48px),env(safe-area-inset-left,0px));padding-right:max(clamp(16px,3vw,48px),env(safe-area-inset-right,0px))}
@media (max-width:820px){.app{grid-template-columns:1fr;height:auto}}

.plane{display:grid;gap:10px;justify-items:center;min-width:0}
/* flying scene: clouds + streaks stream nose-to-tail at a pace set by ground speed (--dur) */
.flight{position:relative;width:100%;height:78vh}
.bob{position:relative;z-index:1;height:100%;display:grid;place-items:center}
/* FSD-style ground: tilted vector map in the dashboard palette, travel direction up, fading out toward the horizon */
.ground{position:absolute;inset:0;opacity:0;transition:opacity 1.2s;
  -webkit-mask-image:radial-gradient(ellipse 50% 55% at 50% 47%,#000 50%,transparent 98%);mask-image:radial-gradient(ellipse 50% 55% at 50% 47%,#000 50%,transparent 98%)}
.flight.has-ground .ground{opacity:1}
.rwn{transition:opacity .4s;font:800 10px var(--display);letter-spacing:.02em;color:#FFFFFF;line-height:1;pointer-events:none;text-shadow:0 0 1px rgba(0,0,0,.25)}
.rwn.on{color:#FFFFFF;text-shadow:0 0 .25em var(--al),0 0 .6em var(--al)}
:root[data-night] .rwn{color:#C9D4E6}
.tfc-cs{position:absolute;left:0;top:0;z-index:2;opacity:0;font:700 11px var(--display);letter-spacing:.08em;color:var(--fg);background:color-mix(in srgb,var(--paper) 80%,transparent);padding:1px 5px;border-radius:4px;pointer-events:none;white-space:nowrap}
.tfc-cs:empty{display:none}
.flight.has-ground .att svg{filter:url(#lit3d) drop-shadow(2vh 3.4vh 1.5vh var(--shadow))}
#app .plane, #app .info{transition:opacity .5s ease}
#app.switching .plane, #app.switching .info{opacity:0;transition-duration:.35s}
.flight .ground.maplibregl-map{position:absolute;inset:0;width:100%;height:100%}   /* MapLibre sets position:relative on its container */
.ground .maplibregl-canvas{outline:none}
.flight.has-ground svg{filter:drop-shadow(2vh 3.4vh 1.5vh var(--shadow))}
.att{width:78%;height:78%;display:grid;place-items:center;transition:opacity 1.2s;transform-style:preserve-3d}
.flight.immersive .att{opacity:0}
.flight.immersive .ground{-webkit-mask-image:radial-gradient(ellipse 58% 64% at 50% 44%,#000 60%,transparent 100%);mask-image:radial-gradient(ellipse 58% 64% at 50% 44%,#000 60%,transparent 100%)}
.flight.immersive .bob{animation:none}
.plane svg{width:100%;height:100%;display:block;transition:filter 1.2s}
.flight.flying .bob{animation:float 6s ease-in-out infinite}
.flight.flying svg{filter:drop-shadow(2.2vh 3.6vh 1.6vh var(--shadow))}
@keyframes float{0%,100%{transform:translateY(0) rotate(0) scaleX(1)}25%{transform:translateY(-1.2%) rotate(.6deg) scaleX(.988)}50%{transform:translateY(.4%) rotate(0) scaleX(1)}75%{transform:translateY(-.8%) rotate(-.6deg) scaleX(.988)}}
/* propellers & rotors */
.prop{animation:prop .26s linear infinite}
@keyframes prop{0%{transform:scaleX(1)}25%{transform:scaleX(.06)}50%{transform:scaleX(-1)}75%{transform:scaleX(-.06)}100%{transform:scaleX(1)}}
.rotor{animation:rotor .5s linear infinite}
@keyframes rotor{to{transform:rotate(360deg)}}
.tailrotor{animation:tail .14s linear infinite}
@keyframes tail{0%,100%{transform:scaleY(1)}50%{transform:scaleY(.1)}}
.flight.parked .prop,.flight.parked .rotor,.flight.parked .tailrotor{animation-play-state:paused}
@media (prefers-reduced-motion:reduce){.prop,.tailrotor{animation:none}.rotor{animation-duration:6s}}
@media (max-width:820px){.flight{height:36vh}.app{gap:12px}.callsign{font-size:clamp(48px,15vw,84px)}}
@media (prefers-reduced-motion:reduce){.flight.flying .bob{animation:none}}
.plane .model{font:600 clamp(18px,2vw,24px) var(--display);letter-spacing:.06em;text-transform:uppercase;color:var(--muted);text-align:center}
.enter{animation:enter .9s cubic-bezier(.2,.7,.2,1)}
@keyframes enter{from{opacity:0;transform:translateY(24px) scale(.97)}to{opacity:1;transform:none}}

.info{display:flex;flex-direction:column;gap:clamp(14px,2.4vh,28px);min-width:0}
.id{display:flex;align-items:center;gap:clamp(14px,2vw,24px);min-width:0}
.fin{width:clamp(84px,9vw,128px);flex:none;filter:drop-shadow(0 6px 10px rgba(16,21,29,.14))}
.who{display:grid;gap:6px;min-width:0}
.airline{font:600 clamp(18px,2vw,24px) var(--body);color:var(--fg);display:flex;align-items:center;gap:10px;flex-wrap:wrap}
.logo{height:30px;max-width:120px;object-fit:contain}
.callsign{font:800 clamp(56px,8.5vw,120px)/.88 var(--display);letter-spacing:.005em;margin:0}
.route{display:flex;align-items:center;gap:clamp(12px,1.6vw,22px);flex-wrap:wrap}
.ap b{display:block;font:700 clamp(30px,3.6vw,48px)/1 var(--display)}
.ap span{font-size:15px;color:var(--muted)}
.route .est{flex-basis:100%;font:600 11px var(--display);letter-spacing:.14em;text-transform:uppercase;color:var(--muted)}
.route .path{flex:1 1 60px;max-width:180px;height:2px;background:linear-gradient(90deg,var(--al),var(--al)) center/100% 2px no-repeat;position:relative}
.route .path::after{content:"";position:absolute;right:-2px;top:-5px;border-left:10px solid var(--al);border-top:6px solid transparent;border-bottom:6px solid transparent}

.stats{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));border-top:2px solid var(--fg)}
@media (max-width:420px){.stats{grid-template-columns:repeat(2,minmax(0,1fr))}}
.stat{padding:12px 12px 14px 0;border-bottom:1px solid var(--line);min-width:0}
.stat .k{font:600 12px var(--display);letter-spacing:.16em;text-transform:uppercase;color:var(--muted)}
.stat .v{font:700 clamp(28px,3.2vw,46px)/1.05 var(--display);font-variant-numeric:tabular-nums;white-space:nowrap}
.stat .v .u{font-size:.45em;font-weight:600;color:var(--muted);margin-left:3px}
.stat .s{font-size:13px;color:var(--muted);font-variant-numeric:tabular-nums;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.arrow{display:inline-block;color:var(--al);transition:transform .8s ease}
.cycle{display:flex;align-items:center;gap:7px;flex-wrap:wrap;font:600 14px var(--display);letter-spacing:.1em;text-transform:uppercase;color:var(--muted);min-height:18px}
.cycle b{width:22px;height:4px;border-radius:2px;background:var(--line);transition:background .3s}
.cycle b.on{background:var(--al)}
.cycle span{margin-left:6px}
.feed{font-size:12px;color:var(--muted)}
.feed i{display:inline-block;width:7px;height:7px;border-radius:50%;background:#2DA66A;margin-right:6px;vertical-align:1px}
.feed.demo i{background:#E0A100}

.empty .callsign{font-size:clamp(48px,7vw,96px)}
.empty p{color:var(--muted);margin:0;font-size:17px}

/* gallery (?gallery) */
.gallery{display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:18px;padding-block:24px;padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px))}
.gallery figure{margin:0;background:#fff;border-radius:10px;padding:12px;display:grid;gap:6px}
.gallery svg{width:100%;height:170px}
.gallery figcaption{font:600 15px var(--display);letter-spacing:.03em}
.gallery small{display:block;font:400 11px var(--body);color:var(--muted)}
@media (prefers-reduced-motion:reduce){.enter{animation:none}.arrow{transition:none}}
</style>
</head>
<body>
<svg width="0" height="0" style="position:absolute" aria-hidden="true"><defs>
  <filter id="lit3d" x="-10%" y="-10%" width="120%" height="120%" color-interpolation-filters="sRGB">
    <feGaussianBlur in="SourceAlpha" stdDeviation="2.2" result="b"/>
    <feSpecularLighting in="b" surfaceScale="5" specularConstant=".9" specularExponent="18" lighting-color="#ffffff" result="spec"><feDistantLight azimuth="235" elevation="38"/></feSpecularLighting>
    <feComposite in="spec" in2="SourceAlpha" operator="in" result="specIn"/>
    <feDiffuseLighting in="b" surfaceScale="5" diffuseConstant="1" lighting-color="#ffffff" result="diff"><feDistantLight azimuth="235" elevation="48"/></feDiffuseLighting>
    <feComposite in="SourceGraphic" in2="diff" operator="arithmetic" k1=".9" k2=".25" result="shaded"/>
    <feComposite in="shaded" in2="SourceAlpha" operator="in" result="shadedIn"/>
    <feComposite in="specIn" in2="shadedIn" operator="arithmetic" k2=".55" k3="1"/>
  </filter>
</defs></svg>
<div class="sky" id="sky" aria-hidden="true">
  <div class="sun" id="sun"><div class="rays"></div></div>
  <div class="moon" id="moon"></div>
  <canvas id="wxCanvas"></canvas>
  <div class="flash" id="flash"></div>
</div>
<div class="app" id="app">
  <div class="plane">
    <div class="flight" id="flight">
      <div class="ground" id="ground" aria-hidden="true" data-credit="Map data © OpenStreetMap contributors · OpenMapTiles · OpenFreeMap"></div>
      <div class="bob"><div class="att" id="att"><svg id="planeSvg" viewBox="-20 -5 40 50" role="img" aria-label="Aircraft"></svg></div></div>
    </div>
    <div class="model" id="model"></div>
  </div>
  <section class="info" id="info" aria-live="polite">
    <div class="id">
      <svg class="fin" id="fin" viewBox="0 0 120 150" aria-hidden="true"></svg>
      <div class="who">
        <div class="airline"><span id="airline">Looking for aircraft…</span><img class="logo" id="logo" alt="" hidden></div>
        <h1 class="callsign" id="callsign">——</h1>
      </div>
    </div>
    <div class="route" id="route" hidden></div>
    <div class="stats" id="stats">
      <div class="stat"><div class="k">Altitude</div><div class="v" id="alt">—</div><div class="s" id="altS"></div></div>
      <div class="stat"><div class="k">Speed</div><div class="v" id="spd">—</div><div class="s" id="spdS"></div></div>
      <div class="stat"><div class="k">Distance</div><div class="v" id="dist">—</div><div class="s" id="distS"></div></div>
      <div class="stat"><div class="k">Track</div><div class="v" id="hdg">—</div><div class="s" id="hdgS"></div></div>
      <div class="stat"><div class="k">Vertical rate</div><div class="v" id="vs">—</div><div class="s" id="vsS"></div></div>
      <div class="stat"><div class="k">In the sky</div><div class="v" id="look">—</div><div class="s" id="lookS"></div></div>
    </div>
    <div class="phase" id="phase"></div>
    <div class="queue" id="queue"></div>
    <div class="wx" id="wx"></div>
    <div class="cycle" id="cycle"></div>
    <div class="feed" id="feed"></div>
  </section>
</div>

<link rel="stylesheet" href="https://unpkg.com/maplibre-gl@4.7.1/dist/maplibre-gl.css">
<script src="https://unpkg.com/maplibre-gl@4.7.1/dist/maplibre-gl.js"></script>
<script src="https://unpkg.com/three@0.160.0/build/three.min.js"></script>
<script>
(() => {
/* ================= AIRCRAFT SILHOUETTES =================
   Every model is drawn from real dimensions (metres): length L, span S, fuselage diameter d,
   wing position/sweep/chords, wingtip style, engine layout, tail layout. Nose points up. */
const DEG = Math.PI/180, F = n => (+n).toFixed(2);
const TIP = {none:.012, round:.03, fence:.012, sharklet:.035, blended:.04, split:.046, raked:.09, curved:.05};

function J(o){ // jet defaults
  const s = Object.assign({kind:'jet', wx:.36, sw:27, kink:.33, tip:'none', eng:[], high:false, nb:.6}, o);
  s.cr ??= s.S*.19; s.ct ??= s.S*.042; s.ck ??= s.cr*.58;
  s.nl ??= s.d*1.8; s.tl ??= s.d*2.8;
  s.ht = Object.assign({x:.82, s:s.S*.36, cr:s.d*1.05, ct:s.d*.4, sw:s.sw+5, t:'low'}, o.ht||{});
  s.finX ??= s.ht.t==='T' ? .72 : .77;
  s.fair ??= s.kind!=='jet' ? [] : s.S>55 ? [.1,.24,.4,.57,.74] : s.S>27 ? [.13,.32,.52,.7] : [.22,.5,.74];
  return s;
}
const P = o => J(Object.assign({kind:'prop', high:true, sw:2, kink:.4, nb:.75, fair:[]}, o));
const G = o => J(Object.assign({kind:'single', high:true, sw:0, kink:.5, tip:'round', nb:.95, fair:[], wx:.3, ht:{x:.84, sw:6}}, o, {ht:Object.assign({x:.84, sw:6}, o.ht||{})}));
const H = (rd, L, n, o={}) => Object.assign({kind:'heli', rd, L, n, fen:false, skids:true}, o);
const BIZ = o => J(Object.assign({wx:.43, sw:27, tip:'blended', fair:[], ht:{t:'T', x:.88}}, o, {ht:Object.assign({t:'T', x:.88}, o.ht||{})}));

const SPECS = {}, CODES = {};
function def(codes, name, spec){ const list = codes.split(' '); SPECS[list[0]] = Object.assign(spec, {name, codes:list}); list.forEach(c => CODES[c] = list[0]); }

/* --- Airbus narrowbody --- */
const a32 = (L,wx,neo) => J({L,S:35.8,d:3.95,wx,cr:7,ct:1.5,sw:25,ck:4.0,tip:neo?'sharklet':'fence',eng:[[.34,neo?5.0:4.4,neo?2.45:2.1,neo?2.9:2.5]],ht:{s:12.45,cr:3.7,ct:1.3,sw:32}});
def('A318','Airbus A318',a32(31.4,.32));
def('A319','Airbus A319',a32(33.8,.33));
def('A320','Airbus A320',a32(37.6,.345));
def('A321','Airbus A321',a32(44.5,.36));
def('A19N','Airbus A319neo',a32(33.8,.33,1));
def('A20N','Airbus A320neo',a32(37.6,.345,1));
def('A21N','Airbus A321neo',a32(44.5,.36,1));
def('BCS1','Airbus A220-100',J({L:35,S:35.1,d:3.7,wx:.34,cr:6.6,ct:1.4,sw:25,ck:3.8,tip:'blended',eng:[[.31,4.6,2.2,2.8]],ht:{s:11.5,cr:3.3,ct:1.2,sw:30}}));
def('BCS3','Airbus A220-300',J({L:38.7,S:35.1,d:3.7,wx:.36,cr:6.6,ct:1.4,sw:25,ck:3.8,tip:'blended',eng:[[.31,4.6,2.2,2.8]],ht:{s:11.5,cr:3.3,ct:1.2,sw:30}}));
/* --- Airbus widebody --- */
const a33 = (L,wx,neo) => J({L,S:neo?64:60.3,d:5.64,wx,cr:10.6,ct:2.4,sw:30,ck:6.2,tip:neo?'sharklet':'blended',eng:[[.33,neo?6.8:6.2,neo?3.5:3.0,neo?4.9:4.6]],ht:{s:19.4,cr:6.3,ct:2.2,sw:33}});
def('A332 A330 MRTT','Airbus A330-200',a33(58.8,.38));
def('A333','Airbus A330-300',a33(63.7,.39));
def('A338','Airbus A330-800neo',a33(58.8,.38,1));
def('A339','Airbus A330-900neo',a33(63.7,.39,1));
def('A343 A342','Airbus A340-300',J({L:63.7,S:60.3,d:5.64,wx:.39,cr:10.6,ct:2.4,sw:30,ck:6.2,tip:'blended',eng:[[.27,5.3,2.05,3.6],[.55,5.3,2.05,3.2]],ht:{s:19.4,cr:6.3,ct:2.2,sw:33}}));
def('A346 A345','Airbus A340-600',J({L:75.4,S:63.5,d:5.64,wx:.41,cr:11,ct:2.4,sw:31,ck:6.4,tip:'blended',eng:[[.29,6.3,2.75,4.2],[.58,6.3,2.75,3.7]],ht:{s:21.5,cr:6.8,ct:2.3,sw:33}}));
def('A359','Airbus A350-900',J({L:66.8,S:64.75,d:5.96,wx:.38,cr:11.7,ct:2.0,sw:31.9,ck:6.6,tip:'curved',eng:[[.33,7.0,3.55,4.8]],ht:{s:19,cr:6.3,ct:2.1,sw:34}}));
